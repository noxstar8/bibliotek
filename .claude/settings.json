{
	"permissions": {
		"allow": ["Bash(npm run *)"],
		"ask": ["Bash(git push *)"],
		"deny": ["Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)"]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-with-prettier.mjs\""
					}
				]
			}
		]
	}
}
